<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agent_06_segmentation</name>
  <version>0.1.0</version>
  <description>
    Agent #06 (instance segmentation) for clear-plastic vial detection.
    YOLOv8-seg path with bbox→polygon train scaffolding and mask-from-bbox
    fallback when no segmentation GT / seg weights exist.
  </description>
  <maintainer email="devnull@example.com">Jessica Camera</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Optional: preferred Detection2DArray publisher. Falls back to JSON String. -->
  <exec_depend>vision_msgs</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
