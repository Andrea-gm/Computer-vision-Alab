<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agent_08_depth_geometry</name>
  <version>0.1.0</version>
  <description>
    Agent 08: depth-aware geometric vial finding (point-cloud clustering,
    plane height, cylinder hypothesis). Subscribes RGB + optional depth +
    camera_info; publishes Detection2DArray (or Float32 fallback), PoseArray,
    and annotated Image.
  </description>
  <maintainer email="devnull@example.com">Jessica Camera</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>message_filters</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
