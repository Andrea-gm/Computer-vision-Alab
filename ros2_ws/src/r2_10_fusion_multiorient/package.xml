<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_10_fusion_multiorient</name>
  <version>0.2.0</version>
  <description>
    Round-2 Agent #10 fusion lead: YOLO rotation-TTA + classical upright/sideways
    cap-axis proposals + orientation-aware NMS + optional cap refine. Detects
    upright AND sideways clear plastic vials with white screw caps.
  </description>
  <maintainer email="devnull@example.com">Jessica Camera</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>orbbec_dual_sync</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
